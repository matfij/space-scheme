{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "oxc"],
    "rules": {
        "no-debugger": "error",
        "no-console": "warn",
        "eqeqeq": "error",
        "curly": "error",
        "typescript/no-explicit-any": "warn",
        "typescript/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ]
    }
}
